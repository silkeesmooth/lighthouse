<Window x:Class="Lighthouse.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Lighthouse.Controls"
        Title="Lighthouse mini" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ToolTip="Drag to move · double-click for the full panel · right-click for options">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="OpenItem" Header="Open Lighthouse" FontWeight="SemiBold" />
            <MenuItem Header="Layout">
                <MenuItem x:Name="FullLayout" Header="Lighthouse and gauges" Tag="full" IsCheckable="True" />
                <MenuItem x:Name="StripLayout" Header="Strip" Tag="strip" IsCheckable="True" />
                <MenuItem x:Name="SceneLayout" Header="Lighthouse only" Tag="lighthouse" IsCheckable="True" />
                <MenuItem x:Name="NumbersLayout" Header="Gauges only" Tag="numbers" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="See-through background">
                <MenuItem x:Name="SolidItem" Header="Off (solid)" Tag="1" IsCheckable="True" />
                <MenuItem x:Name="LightItem" Header="Light" Tag="0.7" IsCheckable="True" />
                <MenuItem x:Name="MediumItem" Header="Medium" Tag="0.35" IsCheckable="True" />
                <MenuItem x:Name="StrongItem" Header="Clear" Tag="0" IsCheckable="True" />
            </MenuItem>
            <MenuItem x:Name="FavoriteMenu" Header="Favorite spot">
                <MenuItem Header="Bottom right" Tag="bottom-right" IsCheckable="True" />
                <MenuItem Header="Bottom" Tag="bottom" IsCheckable="True" />
                <MenuItem Header="Bottom left" Tag="bottom-left" IsCheckable="True" />
                <MenuItem Header="Left" Tag="left" IsCheckable="True" />
                <MenuItem Header="Top left" Tag="top-left" IsCheckable="True" />
                <MenuItem Header="Top" Tag="top" IsCheckable="True" />
                <MenuItem Header="Top right" Tag="top-right" IsCheckable="True" />
                <MenuItem Header="Right" Tag="right" IsCheckable="True" />
                <Separator />
                <MenuItem Header="Where it is now" Tag="custom" IsCheckable="True" />
            </MenuItem>
            <MenuItem x:Name="AvoidTextItem" Header="Move away from text" IsCheckable="True" />
            <Separator />
            <MenuItem x:Name="HideItem" Header="Hide mini monitor" />
        </ContextMenu>
    </Window.ContextMenu>
    <!-- The window is transparent and this border is the panel: only its fill is see-through (MiniWindow sets
         it). The scene and gauges draw solid, and each gauge's text is white or black for what's behind it. -->
    <Border x:Name="Panel" Padding="8,8,8,7" CornerRadius="12">
        <DockPanel x:Name="LayoutRoot" Width="268">
            <c:HarbourScene x:Name="Scene" DockPanel.Dock="Top" Height="70" FramesPerSecond="12" ShowLabels="False" />
            <ItemsControl x:Name="TileList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <c:Gauge Width="44" Height="44" HorizontalAlignment="Center" RingThickness="4"
                                     Value="{Binding Tile.Fraction}" Text="{Binding Tile.GaugeText}"
                                     Stroke="{Binding Arc}" Track="{Binding Track}" Foreground="{Binding Text}" />
                            <TextBlock Text="{Binding Tile.Label}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Text}"
                                       Opacity="0.75" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Tile.Main}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Text}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
