<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- System.Drawing for the tray icon renderer, Screen for the refresh-rate check -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Lighthouse.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.9.6 talks to hardware through PawnIO; it carries no WinRing0 (checked 2026-10-21). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lighthouse.Tests" />
  </ItemGroup>

</Project>
